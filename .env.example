# Resend API key, used by all email-sending routes (contact, apply, newsletter,
# pledge). When unset, routes log the submission to the server
# console and return 200 without sending — useful for local development.
RESEND_API_KEY=

# Vercel Blob storage, for the optional applicant story video.
# Create it in Vercel: Storage -> Create Database -> Blob, then connect it to
# this project. Vercel injects this value automatically; you normally do not
# paste it by hand. When unset, the video section is hidden and the rest of the
# application form works exactly as before.
BLOB_READ_WRITE_TOKEN=

# USPS address verification for the assistance application, from a USPS
# Business account at developers.usps.com (free; create an app and request the
# "Addresses" API). Both are optional and must stay server side.
# When unset, the address fields work as plain required fields: no lookup runs
# and the form says nothing about USPS. The check is advisory either way and
# never blocks a submission, because plenty of rural and new-build addresses
# do not match cleanly and the people this form serves cannot argue with a
# validator.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Optional: set to https://apis-tem.usps.com to work against the USPS test
# environment. Defaults to https://apis.usps.com.
USPS_API_BASE=
