# Resend API key, used by all email-sending routes (contact, apply, newsletter,
# pledge, van-giveaway). When unset, routes log the submission to the server
# console and return 200 without sending — useful for local development.
RESEND_API_KEY=

# Optional: recipient inbox for van giveaway applications.
# Falls back to info@elizabethsgift.com when unset.
VAN_APPLICATION_TO_EMAIL=

# Cloudflare Turnstile bot protection for the van giveaway application.
# Free: dash.cloudflare.com -> Turnstile -> Add site (widget mode "Managed").
# Both keys are optional. When unset, the challenge is skipped entirely and the
# form still runs its honeypot, timing, and rate-limit checks.
# The site key is public and must keep the NEXT_PUBLIC_ prefix; the secret key
# must never be exposed to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob storage, for the optional applicant story video.
# Create it in Vercel: Storage -> Create Database -> Blob, then connect it to
# this project. Vercel injects this value automatically; you normally do not
# paste it by hand. When unset, the video section is hidden and the rest of the
# application form works exactly as before.
BLOB_READ_WRITE_TOKEN=
